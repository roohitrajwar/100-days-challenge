#include <stdio.h>

int main()
{
    long long num;
    int count[10] = {0};
    int digit, i;
    int max = 0, mostDigit = 0;

    printf("Enter a number: ");
    scanf("%lld", &num);

    while(num > 0)
    {
        digit = num % 10;
        count[digit]++;
        num = num / 10;
    }

    for(i = 0; i < 10; i++)
    {
        if(count[i] > max)
        {
            max = count[i];
            mostDigit = i;
        }
    }

    printf("Digit occurring most times = %d\n", mostDigit);
    printf("Frequency = %d", max);

    return 0;
}
