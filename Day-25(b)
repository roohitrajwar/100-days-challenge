#include <stdio.h>

int main()
{
    int n, i;
    int numerator = 3;
    int denominator = 4;
    float sum = 1.0;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    if(n == 1)
    {
        printf("Sum = %.2f", sum);
        return 0;
    }

    for(i = 2; i <= n; i++)
    {
        sum = sum + (float)numerator / denominator;
        numerator = numerator + 2;
        denominator = denominator + 2;
    }

    printf("Sum = %.2f", sum);

    return 0;
}
