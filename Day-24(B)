#include <stdio.h>

int main()
{
    int arr[100], temp[100];
    int n, k, i;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter the value of k: ");
    scanf("%d", &k);

    k = k % n;   n

    // Rotate the array
    for(i = 0; i < n; i++)
    {
        temp[(i + k) % n] = arr[i];
    }

    // Copy back to original array
    for(i = 0; i < n; i++)
    {
        arr[i] = temp[i];
    }

    printf("Array after right rotation:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
