#include <stdio.h>

int main() {
    int num, i;
    int started = 0; // Flag to skip leading zeros

    printf("Enter an integer: ");
    scanf("%d", &num);

    printf("Binary representation: ");

   
    if (num == 0) {
        printf("0");
    } else {
       
        for (i = 31; i >= 0; i--) {
            0
            int bit = (num >> i) & 1;

            if (bit == 1) {
                started = 1; // Found the first non-zero bit
            }

      
            if (started) {
                printf("%d", bit);
            }
        }
    }
    printf("\n");

    return 0;
}
